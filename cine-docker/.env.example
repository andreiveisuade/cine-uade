# Copiar a .env y cambiar las contraseñas. El .env no se versiona.
#
#     cp .env.example .env
#
# El backend lee estas mismas variables (DB_HOST y DB_PORT se los pasa el compose, que
# adentro de Docker son el nombre del servicio y el puerto interno).

# Solo la usa la propia imagen de MySQL para inicializarse. La app no se conecta con root.
MYSQL_ROOT_PASSWORD=cambiar-esta-clave-de-root

# Base y usuario de la aplicación. La imagen le da permisos únicamente sobre esta base.
DB_NAME=appsinteractivas
DB_USER=cine
DB_PASSWORD=cambiar-esta-clave-de-la-app

# Puerto del host donde queda la aplicación. Es el único que se publica.
PUERTO_WEB=8080

# Adminer, publicado solo en 127.0.0.1.
PUERTO_ADMINER=8081

# Zona horaria de los contenedores. Los contenedores corren en UTC si no se les dice
# otra cosa, y con eso las funciones de la noche y los cobros tardíos caen en el día
# siguiente: el arqueo del día los perdería.
TZ=America/Argentina/Buenos_Aires

# Token de TMDB, que el backend usa para importar la cartelera. Se saca gratis en
# https://www.themoviedb.org/settings/api y es el "API Read Access Token" (el largo,
# tipo JWT), no la API key corta.
#
# Sin esto el sistema levanta igual: la pantalla del importador avisa que falta y no
# deja apretar el botón. Lo único que no se puede hacer es traer cartelera.
TMDB_TOKEN=

# Región de la cartelera a importar, en ISO 3166-1.
TMDB_REGION=AR

# No hay "cada cuánto": el importador no corre solo. Trae cartelera cuando el encargado
# se lo pide desde el panel.
