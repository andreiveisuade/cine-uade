{
  "info": {
    "name": "Cine UADE — Demo Etapa 1",
    "description": "Pruebas del back-end para la Etapa 1: consultas (GET), altas (POST), modificaciones (PUT), bajas (DELETE), casos exitosos y casos con datos inválidos o recursos inexistentes.\n\nCorrer las carpetas en orden (Run collection): cada una usa los ids que guarda la anterior, y la última borra todo lo creado. El sistema tiene que estar levantado (`cine-docker`, `docker compose up -d`).\n\nLas credenciales están en las variables `usuario` y `clave`, y la colección las manda como Basic Auth en cada pedido.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{usuario}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{clave}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "usuario",
      "value": "encargado@cine.uade.ar"
    },
    {
      "key": "clave",
      "value": "cine2026"
    },
    {
      "key": "tituloDemo",
      "value": ""
    },
    {
      "key": "peliculaId",
      "value": ""
    },
    {
      "key": "salaId",
      "value": ""
    },
    {
      "key": "funcionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Sesión",
      "description": "Login del encargado. Usuario y clave salen de las variables de la colección.",
      "item": [
        {
          "name": "Login correcto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sesion",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sesion"
              ]
            },
            "description": "Devuelve el empleado sin el hash.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{usuario}}\",\n  \"password\": \"{{clave}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login con clave incorrecta (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 401\", function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sesion",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sesion"
              ]
            },
            "description": "Mismo error para email inexistente y clave equivocada.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{usuario}}\",\n  \"password\": \"clave-equivocada\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
