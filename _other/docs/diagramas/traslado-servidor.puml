@startuml traslado-servidor
title Llevar el servidor a otro equipo - que dice donde esta cada cosa

skinparam nodesep 30
skinparam ranksep 45

node "Navegador" as web
node "PC del encargado\ncine-swing" as swing

node "Cualquier host con Docker" {
  artifact ".env" as env
  node "nginx\n(frontend)" as nginx
  node "backend" as backend
  database "mysql" as mysql
}

web --> nginx : "rutas relativas a /api\n(api-http.js)"
swing --> nginx : "java -Dcine.api.url o CINE_API_URL\n(si no, http://localhost:8080)"
nginx --> backend : "proxy_pass http://backend:8080\n(red interna)"
backend --> mysql : "DB_HOST, DB_PORT, DB_NAME,\nDB_USER, DB_PASSWORD"
env ..> nginx : "PUERTO_WEB\n(8080 si no se dice)"
env ..> backend : "DB_NAME, DB_USER, DB_PASSWORD\n(via docker-compose.yml)"

note bottom of mysql
  Ninguna direccion escrita en el codigo:
  mudar es copiar el repo y el .env,
  docker compose up y apuntar el panel
end note

@enduml
