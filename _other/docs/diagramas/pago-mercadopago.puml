@startuml pago-mercadopago
title Pago online con Mercado Pago: el retorno consulta el pago (la conciliacion es el respaldo)

skinparam sequenceMessageAlign left
skinparam maxMessageSize 220
hide footbox

actor Cliente
participant "Web\n(sesion cookie)" as W
participant "PagoController" as C
participant "GestorPagos" as GP
participant "PasarelaPagos\n(MercadoPagoHttp)" as PP <<Adapter>>
participant "Mercado Pago" as MP <<externo>>

Cliente -> W : Pagar online (medio)
W -> C : POST /api/reservas/codigo/{codigo}/checkout
C -> GP : iniciarCheckout (solo si la reserva es suya, R21)
GP -> PP : crear(reserva, medio, monto)
PP -> MP : crea la preferencia\nexternal_reference = id del checkout,\nsolo los tipos del medio, vence con la reserva
GP --> W : {id, monto, urlPago}
W -> MP : window.location = urlPago
Cliente -> MP : paga con tarjeta de prueba

MP -> Cliente : back_url: /api/checkouts/{id}/retorno
Cliente -> C : GET /api/checkouts/{id}/retorno
C -> GP : retornarDeCheckout(id)
note right of GP
  la query que agrega MP se ignora
  (se puede falsificar)
end note
GP -> PP : autorizar(checkout)
PP -> MP : GET /v1/payments/search?external_reference
MP --> PP : estado, monto, moneda y tipo del pago
alt approved
  GP -> GP : registrarPago (mismo camino que caja)
else rechazado, pendiente o sin pago
  GP --> C : aviso, la reserva queda sin cobrar
end
C --> Cliente : 302 /#/ticket/{codigo}[?aviso=]
@enduml
