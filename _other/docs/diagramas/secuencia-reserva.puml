@startuml secuencia-reserva
title Reservar butacas: POST /api/reservas

skinparam sequenceMessageAlign center
hide footbox

actor Cliente
participant "ReservaController" as Ctrl
participant "GestorReservas" as Gestor
participant "GestorClientes" as Clientes
participant "Ocupacion" as Ocupacion
participant "Asiento" as Asiento <<Entity>>
participant "CalculadoraPrecio" as Precio
participant "Reserva" as Reserva <<Entity>>
participant "ReservaRepository" as Repo <<interface>>
participant "GeneradorTicket" as Ticket <<interface>>

Cliente -> Ctrl : POST /api/reservas\n{funcionId, nombre, email,\nbutacas: codigo -> tarifa, sesion}
activate Ctrl
Ctrl -> Gestor : reservar(funcionId, nombre,\nemail, butacas, sesion)
activate Gestor

Gestor -> Clientes : identificar(nombre, email)
activate Clientes
Clientes --> Gestor : cliente (lo da de alta si no existia)
deactivate Clientes

alt R19: funcion.yaEmpezo(ahora)
  Gestor --> Ctrl : IllegalArgumentException
  Ctrl --> Cliente : 400 {error}
else
  Gestor -> Ocupacion : asientosOcupados(funcionId, sesion)
  activate Ocupacion
  Ocupacion -> Repo : findByFuncion_Id(funcionId)
  Ocupacion -> Ocupacion : vence las impagas (R17)\ny suma los bloqueos ajenos
  Ocupacion --> Gestor : ids tomados
  deactivate Ocupacion

  loop por cada butaca pedida
    Gestor -> Asiento : exigirConCodigo(deLaSala, codigo)
    activate Asiento
    Asiento --> Gestor : la butaca, si es de esta sala
    deactivate Asiento
    Gestor -> Asiento : estaFueraDeServicio() (R9)
    Gestor -> Gestor : no esta entre los tomados (R4)
    Gestor -> Precio : precioDe(funcion, sala,\nasiento, tarifa)
    Precio --> Gestor : precio congelado en la Entrada
  end

  create Reserva
  Gestor -> Reserva : new Reserva(funcion, cliente,\nentradas, ahora)
  Reserva -> Reserva : exige al menos una entrada\ny genera el codigo de acceso

  alt alguna butaca no se puede vender\no no se pidio ninguna
    Gestor --> Ctrl : IllegalArgumentException
    Ctrl --> Cliente : 400 {error}
  else
    Gestor -> Repo : saveAndFlush(reserva)
    activate Repo
    alt UNIQUE (funcion_id, asiento_id) violado
      Repo --> Gestor : DataIntegrityViolationException
      Gestor --> Ctrl : ButacaOcupadaException
      Ctrl --> Cliente : 409 {error}
    else
      Repo --> Gestor : reserva con id
      deactivate Repo
      Gestor -> Ocupacion : liberar(funcionId, sesion)
      Gestor -> Ticket : emitir(reserva, funcion,\npelicula, sala, cliente)
      Gestor --> Ctrl : reserva
      Ctrl --> Cliente : 201 ReservaVistaDTO
    end
  end
end
deactivate Gestor
deactivate Ctrl

@enduml
