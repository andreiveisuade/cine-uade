@startuml
!include _estilo-patrones.iuml
class Reserva <<Context>> {
  - estado : EstadoReserva
  + pagar()
  + cancelar()
  + expirar()
}
enum EstadoReserva <<State>> {
  ~ pagar()
  ~ cancelar()
  ~ expirar()
  ~ ingresar()
  ~ terminarLaFuncion()
  + ocupaButacas()
}
class RESERVADA <<ConcreteState>> {
  pagar() : PAGADA
}
class PAGADA <<ConcreteState>> {
  ingresar() : PAGADA
  terminarLaFuncion() : NO_USADA
}
class "CANCELADA / EXPIRADA / NO_USADA" as Cerradas <<ConcreteState>>
Reserva o--> EstadoReserva
EstadoReserva <|-- RESERVADA
EstadoReserva <|-- PAGADA
EstadoReserva <|-- Cerradas
note bottom of Reserva : estado = estado.pagar()\nlo que el estado no permite, rechaza
note bottom of Cerradas : no sobrescriben nada:\nrechazan todo; NO_USADA es solo\nefectiva (R32), como la vencida
@enduml
