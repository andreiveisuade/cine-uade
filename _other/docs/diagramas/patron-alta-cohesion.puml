@startuml
!include _estilo-patrones.iuml
package "Baja cohesión" {
  class "Ocupacion" as O1 {
    + asientosOcupados(funcionId, sesion)
    + bloquear(funcionId, codigos, sesion)
    + borrarBloqueosVencidos()
    + funcionEnVenta(funcionId)
    - expirarVencidas(reservas)
  }
}
package "Alta cohesión" {
  class "Ocupacion" as O2 {
    + asientosOcupados(funcionId, sesion)
    + libresEntre(asientos, ocupados)
  }
  class BloqueoDeButacas {
    + bloquear(funcionId, codigos, sesion)
    + liberar(funcionId, sesion)
    + borrarVencidos()
  }
  class FuncionesEnVenta {
    + exigir(funcionId) : Funcion
  }
  class ExpiracionDeReservas {
    + expirarVencidas(reservas)
  }
  class ButacasBloqueadas
  O2 --> ExpiracionDeReservas
  BloqueoDeButacas --> O2
  BloqueoDeButacas --> FuncionesEnVenta
  BloqueoDeButacas ..> ButacasBloqueadas
}
note bottom of O1 : R4, bloqueo, R19 y R17 mezclados:\ncuatro motivos para cambiar
@enduml
