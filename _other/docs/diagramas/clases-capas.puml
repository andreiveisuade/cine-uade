@startuml clases-capas
title Arquitectura en capas - Spring Boot + Spring Data JPA

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 12
skinparam ranksep 45
hide members

package controller {
  ' Un subpaquete por subdominio con el controlador y su Vistas* juntos, mas
  ' catalogos/ y http/ (Parseo, Fechas, Creado, ManejadorErrores, ErroresController,
  ' ConfiguracionOpenApi).
  ' Ya no hay rutas/: cada controlador es publico y Spring lo descubre solo.
  ' Una familia de rutas por controlador: el bloqueo de butacas, la Puerta, los
  ' arqueos, las ventas del candy y el buzon de importadas tienen el suyo en vez
  ' de colgar de ReservaController, PagoController, ProductoController o
  ' PeliculaController.

  class "AccesoController, BloqueoController, CajaController\nCatalogoController, ClienteController, CompraCandyController\nFuncionController, GrillaController, ImportacionController\nInformeController, PagoController, PeliculaController\nProductoController, ProgramacionController, PromocionController\nReservaController, RevisionController, SalaController\nSesionController" as Controllers
  class "VistasCartelera, VistasSalas, VistasReservas\nVistasPagos, VistasUsuarios, VistasPromociones\nVistasCandy, VistasInformes, VistasProgramaciones" as Vistas
  class Parseo
  class Fechas
  class Creado
  class ManejadorErrores
  class "ErroresController\n/error en castellano" as ErroresController
}

' Los DTO: un tipo por forma de JSON, sin comportamiento. Los subpaquetes son los
' mismos subdominios que en las demas capas, mas catalogos/ y comun/.
package dto {
  class "cartelera, funciones, programaciones, salas\nventas, candy, promociones, usuarios, informes\ncatalogos, comun\n\nPedido*DTO lo que entra · *VistaDTO lo que sale" as Dtos
}

package service {
  ' Divididos en subpaquetes por area: candy, cartelera, funciones, informes,
  ' programaciones, promociones, salas, usuarios, ventas.

  class GestorCartelera
  class GestorRevisionCartelera
  class GestorImportaciones
  class GestorSalas
  class GestorFunciones
  class GestorProgramaciones
  class GestorClientes
  class GestorReservas
  class GestorPagos
  class GestorAcceso
  class ConsultasReservas
  class GestorCandy
  class GestorProductos
  class GestorEmpleados
  class GestorPromociones
  class GestorInformes
  class GestorCaja
  class PlanificadorGrilla
  class Ocupacion
  interface PoliticaPromociones
  class "DatosPelicula, CriteriosReserva, CriteriosGrilla\nArqueo, ArqueoCandy, Bordero, InformeFuncion\nPropuestaGrilla, DeclaracionJurada, PeriodoDeclarado" as DatosDeServicio

  ' Observer: los gestores publican el hecho y no saben quien lo escucha. Los
  ' comprobantes salen despues del commit: un cobro deshecho no deja recibo.
  class "ReservaCreada, PagoRegistrado\nCompraCandyRegistrada\n(eventos)" as Eventos
  class "ComprobantesDeVentas\n@TransactionalEventListener" as ComprobantesDeVentas
  class "ComprobantesDeCandy\n@TransactionalEventListener" as ComprobantesDeCandy
}

' Los adaptadores de salida. Cada uno es una interfaz en la raiz de su puerto y una
' implementacion en un subpaquete, que elige un @Bean de Adaptadores: la misma
' forma que repository/, un puerto hacia el mundo, no una regla. Estan juntos
' bajo infrastructure/ para que el nivel de arriba del paquete sean las capas.
package infrastructure {

  package seguridad {
    class "ConfiguracionSeguridad\nSpring Security: rutas por rol, Basic, bcrypt" as ConfiguracionSeguridad
    class "PasswordBcrypt\nDecorator del encoder" as PasswordBcrypt
    class PasswordSha256
  }

  package reloj {
    interface Reloj
  }

  package comprobantes {
    interface GeneradorTicket
    interface GeneradorTicketCandy
    interface GeneradorRecibo

    package txt {
      class "GeneradorTicketTxt, GeneradorTicketCandyTxt\nGeneradorReciboTxt" as GeneradoresTxt
    }
  }

  ' Quien autoriza un pago electronico nunca es el cine: R11 pide un codigo que
  ' devuelve un tercero. Es un contrato por lo mismo que GeneradorTicket: hoy
  ' atras hay una emulacion y manana podria haber una integracion real.
  package pasarelas {
    interface PasarelaPagos

    package emulada {
      class "MercadoPagoEmulado\nel checkout, sin credenciales ni red" as PasarelaEmulada
    }
  }

  ' De donde salen las peliculas que el cine no cargo a mano. El contrato no nombra
  ' a TMDB: el gestor pide candidatas y no sabe de donde salen.
  package importador {
    interface CatalogoExterno
    class ImportadorError

    package tmdb {
      class "TmdbHttp\nlas tres llamadas de TMDB" as TmdbHttp
      class "MapeoTmdb\nsu modelo -> el nuestro" as MapeoTmdb
    }
  }
}

package model {
  package cartelera as dom_cartelera {
    class "Pelicula, Importacion @Entity\nCatalogoPelicula\nGenero, Clasificacion\nEstadoRevision (State)" as DomCartelera
  }
  package salas as dom_salas {
    class "Sala, Asiento @Entity\nTipoSala, TipoAsiento, EstadoAsiento" as DomSalas
  }
  package funciones as dom_funciones {
    class "Funcion @Entity\nVersion, Proyeccion" as DomFunciones
  }
  package programaciones as dom_programaciones {
    class "Programacion @Entity" as DomProgramaciones
  }
  package ventas as dom_ventas {
    class "Reserva, Entrada, Pago, BloqueoButaca @Entity\nEstadoReserva (State), MedioPago, TipoTarifa\nCodigoDeAcceso, SesionDeCompra" as DomVentas
  }
  package candy as dom_candy {
    class "Producto, CompraCandy, ItemCompra @Entity\nItemCombo, TipoProducto" as DomCandy
  }
  package promociones as dom_promociones {
    class "Promocion (abstract @Entity)\nPorcentaje, MontoFijo, NxM\nTipoPromocion (Factory Method)\nCondicionesPromocion, ParametrosPromocion" as DomPromociones
  }
  package usuarios as dom_usuarios {
    class "Usuario, Cliente, Empleado @Entity\nRol, Email, Contrasena" as DomUsuarios
  }
  package rechazos as dom_rechazos {
    class "Rechazo (sellada)\nDatoInvalido 400, RecursoNoEncontrado 404\nConflictoDeNegocio 409, ButacaOcupada 409" as DomRechazos
  }
  package "tiempo, validacion" as dom_transversal {
    class "Periodo, FranjaHoraria\nRegla y sus guardas fluidas\n+ <subdominio>/validacion/Validador*" as DomTransversal
  }
}

package repository {
  interface "Repositorio<T>\nexigir(id, que): 404 si no esta" as Repositorio <<la heredan las 13 de id numerico>>
  interface PeliculaRepository
  interface SalaRepository
  interface AsientoRepository
  interface FuncionRepository
  interface ProgramacionRepository
  interface ClienteRepository
  interface ReservaRepository
  interface PagoRepository
  interface "BloqueoButacaRepository\nla butaca mientras se elige" as BloqueoButacaRepository
  interface ProductoRepository
  interface CompraCandyRepository
  interface EmpleadoRepository
  interface PromocionRepository
  interface ImportacionRepository
  class DineroConverter

}

class Aplicacion

Aplicacion .. Controllers : Spring conecta todo\npor component scan
Controllers -down-> service
Controllers -right-> Vistas
Controllers ..> Dtos
Vistas ..> Dtos

' El descuento se resuelve al cobrar, que es cuando recien se conoce el medio
' de pago. GestorPagos depende del contrato, no del gestor que lo implementa.
GestorPagos -right-> PoliticaPromociones
GestorPromociones ..up|> PoliticaPromociones
GestorPromociones -down-> PromocionRepository
GestorCartelera -down-> PeliculaRepository
GestorCartelera -right-> GestorProgramaciones

' El buzon cuelga del catalogo: revisar necesita dar de alta, pero el catalogo no
' necesita saber que existe un importador. Y el que pide cartelera nueva depende del
' puerto, no de TMDB: es el mismo DIP que PasarelaPagos, del lado de la entrada de datos.
GestorRevisionCartelera -right-> GestorCartelera
GestorImportaciones -down-> CatalogoExterno
GestorImportaciones -up-> GestorCartelera
GestorImportaciones -up-> GestorRevisionCartelera
GestorSalas -down-> SalaRepository
GestorSalas -down-> AsientoRepository
GestorFunciones -down-> FuncionRepository

' La grilla se apoya en GestorFunciones y no reescribe R3 ni R8: serian dos
' definiciones de cuando dos funciones se pisan. Son dependencias gestor a
' gestor contra la clase concreta: la unica que pasa por interfaz es
' GestorPagos -> PoliticaPromociones.
GestorProgramaciones -right-> GestorFunciones
GestorProgramaciones -down-> ProgramacionRepository
GestorClientes -down-> ClienteRepository
GestorReservas -down-> ReservaRepository

' Que butacas estan tomadas es una pregunta sobre la funcion, no sobre una
' reserva: por eso Ocupacion es una clase y no un metodo de GestorReservas.
GestorReservas -right-> Ocupacion
GestorAcceso -down-> ReservaRepository
ConsultasReservas -down-> ReservaRepository
Ocupacion -down-> ReservaRepository
Ocupacion -down-> AsientoRepository
Ocupacion -down-> BloqueoButacaRepository
GestorPagos -down-> PagoRepository

' La carta y las ventas del candy cambian por motivos distintos: una cuando
' el cine suma un producto, la otra cuando cambia como se cobra.
GestorCandy -right-> GestorProductos
GestorProductos -down-> ProductoRepository
GestorCandy -down-> CompraCandyRepository
GestorEmpleados -down-> EmpleadoRepository
ConfiguracionSeguridad ..> EmpleadoRepository
ConfiguracionSeguridad ..> PasswordBcrypt
PasswordBcrypt ..> PasswordSha256
GeneradoresTxt ..up|> comprobantes
PeliculaRepository -up-|> Repositorio

' Observer: publicar no es depender del que escucha. Los gestores ya no
' conocen a ningun generador; los comprobantes los emite quien escucha.
GestorReservas ..> Eventos : publica
GestorPagos ..> Eventos : publica
GestorCandy ..> Eventos : publica
ComprobantesDeVentas ..> Eventos : escucha
ComprobantesDeCandy ..> Eventos : escucha
ComprobantesDeVentas -down-> GeneradorTicket
ComprobantesDeVentas -down-> GeneradorRecibo
ComprobantesDeCandy -down-> GeneradorTicketCandy

GestorPagos -down-> PasarelaPagos
PasarelaEmulada ..up|> PasarelaPagos

GestorInformes -down-> PagoRepository
GestorInformes -down-> CompraCandyRepository

' El planificador no persiste nada: propone una grilla y quien decide es el
' administrador. Se apoya en GestorFunciones para no reescribir R3.
PlanificadorGrilla -right-> GestorFunciones

repository ..> model
infrastructure ..> model
service ..> repository
service ..> infrastructure

legend bottom
  |= Capa |= De que se ocupa |
  | controller | HTTP: 19 @RestController, una familia de rutas cada uno, y nueve Vistas*. Ninguna regla vive aca |
  | dto | La forma del JSON. Objetos sin comportamiento |
  | service | Las reglas que necesitan la base, el reloj u otros objetos. Los comprobantes, despues del commit |
  | model | Que es un cine: entidades, Value Objects, Validador* y Rechazo. No depende de ninguna otra capa |
  | repository | 14 interfaces JpaRepository; 13 heredan exigir() de Repositorio<T>. Spring Data las implementa |
  | infrastructure | Los puertos hacia afuera: comprobantes, pasarelas, importador, reloj, seguridad |
  | Aplicacion | @SpringBootApplication + main(). La implementacion de cada puerto la elige Adaptadores |
endlegend

@enduml
