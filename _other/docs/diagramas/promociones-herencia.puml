@startuml promociones-herencia
title Promociones: una jerarquia, no un switch

skinparam classAttributeIconSize 0
skinparam nodesep 18
skinparam ranksep 34

abstract class Promocion <<@Entity>> {
  nombre
  vigencia : Periodo
  diasSemana
  franja : FranjaHoraria
  mediosPago
  --
  aplicaA(inicioFuncion, medio)
  {abstract} getParametros()
  {abstract} calcularDescuento(entradas de tarifa general)
}

class PromocionPorcentaje {
  porcentaje
  --
  subtotal x 0.30
}

class PromocionMontoFijo {
  monto
  --
  $2000 off
}

class PromocionNxM {
  n, m
  --
  2x1: las (cant/n)x(n-m)
  entradas mas baratas
}

enum TipoPromocion <<Factory Method>> {
  PORCENTAJE
  MONTO_FIJO
  NXM
  --
  {abstract} crear(nombre, parametros, condiciones, hoy)
}

Promocion <|-- PromocionPorcentaje
Promocion <|-- PromocionMontoFijo
Promocion <|-- PromocionNxM
TipoPromocion ..> Promocion : cada constante\ncrea su subclase

@enduml
