@startuml
!include _estilo-patrones.iuml
package "Diseño 1: el gestor crea la Entrada" {
  class "GestorReservas" as G1
  class "Reserva" as R1
  class "Entrada" as E1
  G1 ..> E1 : <<create>>
  G1 --> R1 : agregar(entrada)
  R1 --> E1
}
package "Diseño 2 (preferido): Reserva crea la Entrada" {
  class "GestorReservas" as G2
  class "Reserva" as R2
  class "Entrada" as E2
  G2 --> R2 : new Reserva(funcion, cliente, butacas)
  R2 ..> E2 : <<create>>
}
note bottom of G1 : el gestor queda acoplado\na Reserva y a Entrada
note bottom of G2 : el gestor solo conoce a Reserva:\nmenos acoplamiento y\nmás cohesión
@enduml
