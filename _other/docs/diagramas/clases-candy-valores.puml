@startuml clases-candy-valores
title Modelo de dominio (3/3) - candy y los Value Objects de plata y tiempo

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members
set namespaceSeparator none

' Una de las tres vistas del modelo (clases-catalogo, clases-ventas, clases-candy-valores):
' en un solo diagrama media 6800px de ancho y no se leia. Los comentarios ' son el porque
' de cada decision y la materia prima del manual.

package "model.candy" {
  ' Composite: Producto es el Component y cada uno contesta su precio suelto y su
  ' ahorro, sin que nadie pregunte si es combo. Combo.armar() crea sus ItemCombo
  ' (Creador) y valida R14 antes de devolverlo: no hay combo sin componentes.
  ' Editar un combo revisa R14 (validarEdicion); exigirQueSigaConviniendo() es el
  ' otro lado, el combo al que le abarataron un componente: se lo pregunta el
  ' gestor. Sin stock no se borra, sale de la venta: vive en compras viejas.
  abstract class Producto <<Entity>> {
    +getNombre(): String
    +getTipo(): TipoProducto
    +getPrecio(): Dinero
    +estaDisponible(): boolean
    +{abstract} getPrecioSuelto(): Dinero
    +{abstract} getAhorro(): Dinero
    +getComponentes(): List<ItemCombo>
    +editar(nombre, precio)
    +sacarDeLaVenta() / volverALaVenta()
  }
  class ProductoSuelto <<Entity>> {
    +getPrecioSuelto(): Dinero
    +getAhorro(): Dinero
  }
  class Combo <<Entity>> {
    {static} +armar(nombre, precio, componentes): Combo
    +getPrecioSuelto(): Dinero
    +getAhorro(): Dinero
    +exigirQueSigaConviniendo()
  }
  ' La autoreferencia es lo que hace al combo una promocion y no un producto
  ' con nombre bonito: sabiendo que trae, el propio Combo valida que cueste
  ' menos que comprarlo suelto (R14).
  class ItemCombo <<Embeddable>> {
    +producto(): Producto
    +nombre(): String
    +precioSuelto(): Dinero
    +cantidad(): int
  }
  ' No pasa por Pago y no tiene estados: en el mostrador se cobra en el acto,
  ' asi que nace pagada y lleva encima el medio.
  ' Las dos asociaciones en 0..1 no son redundantes: la venta de mostrador no
  ' tiene ninguna, y la del "desea agregar pochoclos?" posterior a la compra
  ' web tiene reserva, de donde sale el cliente sin volver a pedirlo.
  ' Creadora de sus renglones: recibe cada producto con su cantidad, exige
  ' medio de pago y R11, y arma cada ItemCompra, que exige cantidad y stock.
  class CompraCandy <<Entity>> {
    +getClienteId(): Integer
    +getReservaId(): Integer
    +getFecha(): LocalDateTime
    +getMedio(): MedioPago
    +getCodigoAutorizacion(): String
    +getItems(): List<ItemCompra>
    +getTotal(): Dinero
    +getAhorro(): Dinero
  }
  ' Nombre, precio y ahorro del combo quedan congelados al vender: editar el
  ' producto despues no cambia una compra vieja.
  class ItemCompra <<Entity>> {
    +producto(): Producto
    +nombre(): String
    +cantidad(): int
    +precioUnitario(): Dinero
    +getSubtotal(): Dinero
    +getAhorro(): Dinero
  }
  enum TipoProducto <<enum>> {
    POCHOCLOS / BEBIDA
    GOLOSINA / COMBO
    +esCombo(): boolean
  }
}

package "model.dinero" {
  ' Dinero es un value object, no una entidad: sin id ni DAO propio, y viaja como
  ' TIPO de atributo en todo el dominio (funciones, programaciones, ventas,
  ' promociones, candy) en los lugares donde antes habia un double. Un double no
  ' representa 0,10 exacto y las cuentas de plata terminan mintiendo de a poco;
  ' Dinero guarda centavos enteros y evita el problema de raiz.
  ' importe() convierte el precio de un pedido y lo valida (falta, > 0, dos
  ' decimales, tope). No lleva flechas hacia el resto del modelo, por el mismo
  ' motivo que los enums: es un tipo, no una entidad con la que otra "se relaciona".
  class Dinero <<record>> {
    centavos: long
    --
    {static} +importe(Double, que): Dinero
    +aPesos(): double
    +mas(Dinero): Dinero
    +menos(Dinero): Dinero
    +por(factor): Dinero
    +porcentaje(double): Dinero
    +acotadoA(techo): Dinero
    +sinBajarDeCero(): Dinero
    +esMayorQue(Dinero): boolean
  }
}

package "model.tiempo" {
  ' Value Objects @Embeddable sobre las columnas de siempre: la vigencia de una
  ' promocion y el rango de una programacion (Periodo), la franja horaria de una
  ' promocion (FranjaHoraria). No se arman al reves y una punta en null queda
  ' abierta. Sin flechas, por lo mismo que Dinero.
  class Periodo <<record>> <<Embeddable>> {
    desde: LocalDate [0..1]
    hasta: LocalDate [0..1]
    --
    +incluye(dia): boolean
  }
  class FranjaHoraria <<record>> <<Embeddable>> {
    desde: LocalTime [0..1]
    hasta: LocalTime [0..1]
    --
    +incluye(hora): boolean
  }
}

' De la vista 2/3: solo el nombre, para anclar las flechas.
class Cliente <<Entity>>
class Reserva <<Entity>>
Producto <|-- ProductoSuelto
Producto <|-- Combo
Combo "1" *-- "2..*" ItemCombo : contiene y crea >
ItemCombo "*" --> "1" Producto : refiere a >
CompraCandy "*" --> "0..1" Cliente
CompraCandy "*" --> "0..1" Reserva
CompraCandy "1" *-- "1..*" ItemCompra : crea >
ItemCompra "*" --> "1" Producto

@enduml
