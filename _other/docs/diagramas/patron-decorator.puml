@startuml
!include _estilo-patrones.iuml
interface SecurityContextRepository <<Component>> {
  + saveContext(contexto, pedido, respuesta)
}
class SesionDeClientes <<Decorator>> {
  - sesiones : HttpSessionSecurityContextRepository
  + saveContext(contexto, pedido, respuesta)
}
class HttpSessionSecurityContextRepository <<ConcreteComponent>>
SecurityContextRepository <|.. SesionDeClientes
SecurityContextRepository <|.. HttpSessionSecurityContextRepository
SesionDeClientes o--> HttpSessionSecurityContextRepository
note bottom of SesionDeClientes : solo guarda sesión\nsi el usuario es cliente
@enduml
