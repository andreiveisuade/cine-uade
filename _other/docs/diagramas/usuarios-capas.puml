@startuml usuarios-capas
title Usuarios y cuentas: una pieza por renglon, de la tabla a los clientes

skinparam componentStyle rectangle
skinparam nodesep 16
skinparam ranksep 30
skinparam defaultTextAlignment left

package "clientes (no deciden nada)" {
  [web cuenta/\nIngresar, Registro, MiCuenta, RecuperarClave\ncookie JSESSIONID] as WEB
  [Swing\nVentanaLogin, PantallaClientes\nBasic en cada pedido] as SW
  [Android\nPantallaLogin, ApiPuerta\nBasic en cada pedido] as AND
}

package "controller/usuarios" {
  [SesionController\nPOST /sesion: devuelve al ya autenticado] as SC
  [ClienteController\nPOST /clientes: alta (R22)] as CC
  [CuentaController\n/cuenta: nombre, clave, baja, recuperacion\nclave temporal (R23 a R27)] as CUC
}

package "service/usuarios" {
  [GestorClientes\nalta, reclamo del email con codigo (R22)] as GCL
  [GestorCuentas\ncuenta ya abierta: R23 a R27] as GCU
  [GestorEmpleados\nalta y busqueda del personal] as GEM
}

package "infrastructure/seguridad" {
  [ConfiguracionSeguridad\nquien llama a que; cerrado por defecto] as CFG
  [PasswordBcrypt\nhashea y compara (SHA-256 viejo se migra)] as BC
  [SesionDeClientes\nsolo la sesion del CLIENTE va a cookie] as SDC
  [RegistroDeSesiones\nsesiones por email, para cerrarlas] as RS
  [FiltroDeSesionesCerradas\ncookie de sesion cerrada = sin cookie] as FSC
  [LimiteDeIntentos\n5 fallos por email o IP: 1 min (429)] as LI
}

package "model/usuarios" {
  [Usuario  <- Cliente, Empleado\nnombre, email, rol; Cliente: abrir/cerrar cuenta] as US
  [Email\nnormalizado, se busca igual en todos lados] as EM
  [Contrasena\npolitica de la clave; genera la temporal] as CO
}

database "tabla usuario\nrol (discriminador), email UNIQUE,\npassword_hash bcrypt (NULL = sin cuenta),\ndebe_cambiar_clave" as DB

WEB --> SC
WEB --> CC
WEB --> CUC
SW --> SC
SW --> CUC
AND --> SC
SC --> GCL
SC --> GEM
CC --> GCL
CUC --> GCU
GCU --> LI
GCU --> RS
GCU --> BC
GCL --> BC
GCU --> US
GCL --> US
US --> EM
US --> CO
US --> DB : JPA
CFG ..> SDC
CFG ..> FSC
CFG ..> LI
CFG ..> BC
@enduml
