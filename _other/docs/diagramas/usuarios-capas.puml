@startuml usuarios-capas
title Usuarios y cuentas: una pieza por renglon, de la tabla a los clientes

skinparam componentStyle rectangle
skinparam nodesep 16
skinparam ranksep 30
skinparam defaultTextAlignment left

package "clientes (no deciden nada)" {
  [web cuenta/\nIngresar (con Google), MiCuenta\ncookie JSESSIONID] as WEB
  [Swing\nVentanaLogin, PantallaClientes (buscar)\nBasic en cada pedido] as SW
  [Android\nPantallaLogin, ApiPuerta\nBasic en cada pedido] as AND
}

cloud "Google\n(OIDC)" as GOO

package "controller/usuarios" {
  [SesionController\nPOST /sesion: devuelve al ya autenticado] as SC
  [ClienteController\nGET /clientes?email: busqueda] as CC
  [CuentaController\n/cuenta: nombre y baja (R23, R26)] as CUC
}

package "service/usuarios" {
  [GestorClientes\ningresarConGoogle (R28), renombrar (R23)] as GCL
  [GestorEmpleados\nalta y busqueda del personal] as GEM
}

package "infrastructure/seguridad" {
  [ConfiguracionSeguridad\nquien llama a que; cerrado por defecto\noauth2Login si hay credenciales] as CFG
  [ClientesDeGoogle\nAdapter de OidcUserService:\nemail verificado -> cliente] as CDG
  [PasswordEncoder\nbcrypt, solo empleados] as BC
  [SesionDeClientes\nsolo la sesion del CLIENTE va a cookie] as SDC
  [LimiteDeIntentos\nBasic: 5 fallos por email o IP, 1 min (429)] as LI
}

package "model/usuarios" {
  [Usuario  <- Cliente, Empleado\nnombre, email, rol; Empleado: passwordHash] as US
  [Email\nnormalizado, se busca igual en todos lados] as EM
  [Contrasena\npolitica de la clave del empleado] as CO
}

database "tabla usuario\nrol (discriminador), email UNIQUE,\npassword_hash bcrypt solo de empleados" as DB

WEB --> GOO : boton de ingresar\n/oauth2/authorization/google
GOO --> CDG : vuelve con el codigo
WEB --> SC
WEB --> CUC
SW --> SC
SW --> CC
AND --> SC
CDG --> GCL
SC --> GEM
CC --> GCL
CUC --> GCL
GEM --> BC
GCL --> US
GEM --> US
US --> EM
US --> CO
US --> DB : JPA
CFG ..> CDG
CFG ..> SDC
CFG ..> LI
CFG ..> BC
@enduml
