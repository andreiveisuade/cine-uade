@startuml capas
title Capas y paquetes - Spring Boot + Spring Data JPA

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 12
skinparam ranksep 40
hide members

package controller {
  package http {
    class "Parseo, Fechas, Creado\nManejadorErrores, ErroresController\nConfiguracionOpenApi" as Http
  }
  class "candy, cartelera, catalogos, funciones, informes\nprogramaciones, promociones, salas, usuarios, ventas\n\n19 @RestController (una familia de rutas cada uno, sin fachada)\ny en el mismo subpaquete su Vistas* (ensamblador de DTO)" as Controllers
}

package dto <<mismos subdominios que las demas capas>> {
  class "candy, cartelera, catalogos, comun, funciones\ninformes, programaciones, promociones\nsalas, usuarios, ventas" as Dtos
}

package service {
  package candy as srv_candy {
    class "GestorCandy, GestorProductos\nComprobantesDeCandy, CompraCandyRegistrada" as SrvCandy
  }
  package cartelera as srv_cartelera {
    class "GestorCartelera, GestorRevisionCartelera\nGestorImportaciones, DatosPelicula" as SrvCartelera
  }
  package funciones as srv_funciones {
    class "GestorFunciones\nAgendaDeSala" as SrvFunciones
  }
  package informes as srv_informes {
    class "GestorInformes, GestorCaja\nArqueo, ArqueoCandy, Bordero, InformeFuncion\nDeclaracionJurada, PeriodoDeclarado" as SrvInformes
  }
  package programaciones as srv_programaciones {
    class "GestorProgramaciones, PlanificadorGrilla\nElencoGrilla, IndicadoresGrilla, PuntajeConfiable\nPlanProgramacion, CriteriosGrilla, PropuestaGrilla" as SrvProgramaciones
  }
  package promociones as srv_promociones {
    class "GestorPromociones\nPoliticaPromociones" as SrvPromociones
  }
  package salas as srv_salas {
    class "GestorSalas" as SrvSalas
  }
  package usuarios as srv_usuarios {
    class "GestorClientes\nGestorEmpleados" as SrvUsuarios
  }
  package ventas as srv_ventas {
    class "GestorReservas, GestorPagos, GestorAcceso\nConsultasReservas, Ocupacion, CriteriosReserva\nComprobantesDeVentas, ReservaCreada, PagoRegistrado" as SrvVentas
  }
}

package model <<no depende de ninguna otra capa>> {
  class "cartelera, salas, funciones, programaciones\nventas, candy, promociones, usuarios, dinero\n+ rechazos, validacion, tiempo\n(cada subdominio con su validacion/Validador*)" as DomSubpaquetes
}

package repository {
  class "Repositorio<T>: exigir(id) o 404, en un solo lugar\n14 interfaces JpaRepository por subdominio\n(sin implementacion propia; 13 heredan Repositorio)\n+ dinero/DineroConverter" as Repos
}

package infrastructure {
  class "comprobantes, importador, pasarelas\nreloj, seguridad + Adaptadores" as Infra
}

class Aplicacion

Controllers -down-> service
Controllers ..> Dtos

service ..> repository
service ..> infrastructure
repository ..> model
infrastructure ..> model

Aplicacion .. Controllers

@enduml
