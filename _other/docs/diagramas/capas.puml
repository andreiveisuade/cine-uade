@startuml capas
title Capas y paquetes - Spring Boot + Spring Data JPA

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 12
skinparam ranksep 40
hide members

package controller {
  package http {
    class "Parseo, Fechas, Creado\nManejadorErrores, ConfiguracionOpenApi" as Http
  }
  class "candy, cartelera, catalogos, funciones, informes\nprogramaciones, promociones, salas, usuarios, ventas\n\n18 @RestController (una familia de rutas cada uno, sin fachada)\ny en el mismo subpaquete su Vistas* (ensamblador de DTO)" as Controllers
}

package dto {
  class "candy, cartelera, catalogos, comun, funciones\ninformes, programaciones, promociones\nsalas, usuarios, ventas" as Dtos
}

package service {
  package candy as srv_candy {
    class "GestorCandy\nGestorProductos" as SrvCandy
  }
  package cartelera as srv_cartelera {
    class "GestorCartelera, GestorRevisionCartelera\nGestorImportaciones, DatosPelicula" as SrvCartelera
  }
  package funciones as srv_funciones {
    class "GestorFunciones\nAgendaDeSala" as SrvFunciones
  }
  package informes as srv_informes {
    class "GestorInformes, GestorCaja\nArqueo, Bordero, InformeFuncion\nDeclaracionJurada, PeriodoDeclarado" as SrvInformes
  }
  package programaciones as srv_programaciones {
    class "GestorProgramaciones, PlanificadorGrilla\nPuntajeConfiable, PlanProgramacion\nCriteriosGrilla, PropuestaGrilla" as SrvProgramaciones
  }
  package promociones as srv_promociones {
    class "GestorPromociones\nPoliticaPromociones" as SrvPromociones
  }
  package salas as srv_salas {
    class "GestorSalas" as SrvSalas
  }
  package usuarios as srv_usuarios {
    class "GestorClientes\nGestorEmpleados" as SrvUsuarios
  }
  package ventas as srv_ventas {
    class "GestorReservas, GestorPagos, GestorAcceso\nConsultasReservas, Ocupacion\nCalculadoraPrecio, CriteriosReserva" as SrvVentas
  }
}

package model {
  class "cartelera, salas, funciones, programaciones\nventas, candy, promociones, usuarios, dinero" as DomSubpaquetes
}

package repository {
  class "14 interfaces JpaRepository por subdominio\n(sin implementacion propia)\n+ dinero/DineroConverter" as Repos
}

package infrastructure {
  class "comprobantes, importador, pasarelas\nreloj, seguridad + Adaptadores" as Infra
}

class Aplicacion

Controllers -down-> service
Controllers ..> Dtos

service ..> repository
service ..> infrastructure
repository ..> model
infrastructure ..> model

note bottom of model
  No depende de NADA externo: ni de
  controller, ni de service, ni de
  repository, ni de una libreria de
  terceros salvo java.time. Es la unica
  capa que se podria llevar a otro
  proyecto tal cual.
end note

note top of Dtos
  Todas las capas usan la misma lista de
  subdominios: sabiendo el subdominio se
  sabe el paquete en cualquiera de ellas.
end note

Aplicacion .. Controllers

@enduml
