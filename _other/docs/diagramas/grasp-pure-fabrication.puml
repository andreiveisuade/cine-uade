@startuml grasp-pure-fabrication
title GRASP: Fabricacion pura - clases que el modelo pedia sin ser entidad ni gestor

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

' Las cuatro no son una entidad del dominio -no representan un concepto del
' cine que un cliente reconozca, como Reserva o Funcion- ni son el gestor de
' un caso de uso -no tienen un CU-XX propio en el manual-. Existen porque
' asignarle esa responsabilidad a la entidad o al gestor mas cercano rompia
' otra cosa: alta cohesion de un lado, un segundo lugar con la misma logica
' del otro. Fabricacion pura es exactamente ese tercer lugar.

package "service.ventas" {
  class Ocupacion <<unica definicion de ocupado, R4>> {
    +funcionEnVenta(funcionId): Funcion
    +asientosOcupados(funcionId, sesion): Set<Integer>
    {static} +libresEntre(asientos, ocupados): List<Asiento>
    +bloquear(funcionId, codigos, sesion): Bloqueo
    +liberar(funcionId, sesion)
  }
}

package "service.funciones" {
  class GestorFunciones {
    +agendaDe(salaId, desde, hasta): AgendaDeSala
  }
  class AgendaDeSala <<unica definicion de R3>> {
    +chocaCon(inicio, fin): Optional<Funcion>
    +chocaEn(inicio, fin): boolean
  }
}

package "service.programaciones" {
  class PlanificadorGrilla
  class ElencoGrilla <<cuenta sobre una lista, sin base>> {
    {static} ~elegir(confirmadas, cuantas): List<Pelicula>
  }
  class PuntajeConfiable <<promedio bayesiano, sin base>> {
    ~PuntajeConfiable(catalogo: List<Pelicula>)
    ~de(Pelicula): double
  }
}

GestorFunciones -right-> AgendaDeSala : agendaDe()\nconstruye y devuelve
PlanificadorGrilla -up-> AgendaDeSala : chocaEn(), una vez\npor sala por corrida
PlanificadorGrilla -down-> ElencoGrilla : elegir(), una vez\npor corrida
PlanificadorGrilla -right-> PuntajeConfiable : una por corrida,\nde() por pelicula
ElencoGrilla -right-> PuntajeConfiable

@enduml
