@startuml
!include _estilo-patrones.iuml
class GestorReservas <<Subject>>
class GestorPagos <<Subject>>
class GestorCandy <<Subject>>
interface ApplicationEventPublisher <<Subject>> {
  + publishEvent(evento)
}
class ReservaCreada <<Event>>
class PagoRegistrado <<Event>>
class CompraCandyRegistrada <<Event>>
class ComprobantesDeVentas <<Observer>> {
  + emitirTicket(ReservaCreada)
  + emitirRecibo(PagoRegistrado)
}
class ComprobantesDeCandy <<Observer>> {
  + emitirTicket(CompraCandyRegistrada)
}
GestorReservas ..> ApplicationEventPublisher : publica
GestorPagos ..> ApplicationEventPublisher : publica
GestorCandy ..> ApplicationEventPublisher : publica
ApplicationEventPublisher ..> ReservaCreada
ApplicationEventPublisher ..> PagoRegistrado
ApplicationEventPublisher ..> CompraCandyRegistrada
ComprobantesDeVentas ..> ReservaCreada : escucha
ComprobantesDeVentas ..> PagoRegistrado : escucha
ComprobantesDeCandy ..> CompraCandyRegistrada : escucha
note bottom of ComprobantesDeCandy : @TransactionalEventListener AFTER_COMMIT:\nsin commit no hay comprobante
@enduml
