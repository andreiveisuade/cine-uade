@startuml peticion-capas
title Una peticion, de punta a punta: contenedores, puertos y capas

skinparam sequenceMessageAlign left
skinparam maxMessageSize 200
skinparam BoxPadding 12

actor Navegador as N

box "contenedor frontend\nred: web" #F7EBE3
  participant "nginx\n:8080" as NGINX
end box

box "contenedor backend\nredes: web + datos" #F2F0ED
  participant "ReservaController\ncontroller/ventas/" as CTRL
  participant "VistasReservas\ncontroller/ventas/" as VIS
  participant "GestorReservas\nservice/ventas/" as GEST
  participant "ReservaRepository\nrepository/ventas/" as REPO
end box

box "contenedor mysql\nred: datos" #F2F0ED
  database "MySQL\n:3306" as DB
end box

N -> NGINX : POST /api/reservas\nlocalhost:8080 (unico puerto publicado)

NGINX -> CTRL : proxy_pass backend:8080\n(mismo origen: sin CORS)

CTRL -> CTRL : PedidoReservaDTO\n(Jackson deserializa)
CTRL -> GEST : reservar(funcionId, nombre,\nemail, butacas, sesion)
activate GEST

GEST -> GEST : coordina R19 y R4; Funcion,\nAsiento y Reserva validan lo suyo
alt una entidad o el gestor rechazan
  GEST --> CTRL : Rechazo (model/rechazos/)
  CTRL --> NGINX : ManejadorErrores: DatoInvalido 400,\nRecursoNoEncontrado 404, ConflictoDeNegocio\ny ButacaOcupada 409, {error} con el texto intacto
else
GEST -> REPO : saveAndFlush(reserva)
REPO -> DB : INSERT reserva + entrada
DB --> REPO : id
REPO --> GEST : Reserva
GEST --> CTRL : Reserva
deactivate GEST

CTRL -> VIS : reserva(Reserva)
VIS --> CTRL : ReservaVistaDTO

CTRL --> NGINX : 201 + Location + JSON
end
NGINX --> N : la respuesta, tal cual

@enduml
