@startuml docker-despliegue
title Despliegue con Docker Compose - cine-docker

skinparam nodesep 20
skinparam ranksep 45

actor "Cliente" as usuario
actor "Encargado /\nacomodador" as encargado
node "cine-swing\n(escritorio, fuera de Docker)" as swing

folder "cine-frontend\n(carpeta del monorepo)" as repoFrontend
folder "cine-backend\n(carpeta del monorepo)" as repoBackend

node "Docker host\ndocker-compose.yml (cine-docker)" {
  frame "red **web**" {
    node "cine-frontend\nnginx-unprivileged:1.27-alpine" as frontend
  }

  node "cine-backend\neclipse-temurin:21-jre-alpine" as backend

  frame "red **datos**" {
    database "cine-mysql\nmysql:8.4\n(initdb con el volumen vacio:\n01-schema.sql, 02-admin.sql;\nguarda bloqueo_butaca)" as mysql
    node "cine-adminer\nadminer:5" as adminer
  }

  artifact "mysql_data\n(volumen nombrado)" as vol
}

artifact ".env (no versionado)\nMYSQL_ROOT_PASSWORD, DB_USER, DB_PASSWORD, DB_NAME\nPUERTO_WEB, PUERTO_ADMINER, TZ\nTMDB_TOKEN, TMDB_REGION" as env

actor "Desarrollador" as dev
cloud "TMDB\napi.themoviedb.org" as tmdb

repoFrontend .down.> frontend : build context
repoBackend .down.> backend : build context

usuario --> frontend : "localhost:8080"
encargado --> swing
swing --> frontend : "localhost:8080/api\n(HTTP Basic)"
dev --> adminer : "127.0.0.1:8081"

frontend --> backend : proxy_pass /api\n-> backend:8080
backend --> tmdb : GET now_playing?region=AR\n(TMDB_TOKEN, a pedido del encargado)
backend --> mysql : DB_HOST=mysql:3306
adminer --> mysql : ADMINER_DEFAULT_SERVER
mysql --> vol : monta en\n/var/lib/mysql

legend bottom
  |= Elemento |= Detalle |
  | Puertos al host | Solo nginx (8080) y adminer (127.0.0.1:8081). mysql y backend no publican nada |
  | red **web** | frontend <-> backend |
  | red **datos** | backend y adminer <-> mysql. El frontend no tiene ruta hasta la base |
  | backend | Unico contenedor en las dos redes: es el puente. Sin puerto propio, sin CORS |
  | cine-swing | Un cliente HTTP mas: entra por el mismo nginx que la web |
  | TMDB | Adaptador dentro del backend (infrastructure/importador/), a pedido del encargado |
  | cine-docker | Solo orquesta: compose, .env y el seed. Sin codigo de la app |
  | Orden de arranque | mysql healthy -> backend healthy -> frontend |
endlegend

env ..> mysql
env ..> backend

@enduml
