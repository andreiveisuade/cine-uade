@startuml importador-flujo
title Importador de cartelera: TMDB entra por las reglas del cine

skinparam sequenceMessageAlign left
skinparam maxMessageSize 200

actor "Encargado" as E
participant "nginx" as NG
participant "GestorImportaciones\nservice/cartelera/" as GI
participant "TmdbHttp\ninfrastructure/importador/" as TM
participant "MapeoTmdb" as MAP
participant "GestorRevisionCartelera" as GR
database MySQL as DB

E -> NG : POST /api/importaciones\n(boton Traer cartelera\ndel panel Swing)
NG -> GI : proxy_read_timeout 180s
activate GI

GI -> TM : cartelera de AR
activate TM
TM -> TM : now_playing + detalle\n+ release_dates\n(de a 4 en paralelo)
TM -> MAP : traduce
MAP --> TM : 19 generos -> 9\nISO 639 -> texto\nsin certificacion -> MAS_13
TM --> GI : candidatas
deactivate TM

loop una por vez, en orden
  GI -> GI : R1: ya esta ese titulo?\nsi esta, salteada
  GI -> GR : importar(datos)
  GR -> DB : alta por GestorCartelera:\nPelicula valida R2, R7, R10
  GR -> GR : pelicula.dejarPendiente()\n(PENDIENTE, fuera de cartelera)
  opt la candidata falla (un Rechazo o un error de la base)
    GI -> GI : cuenta fallida y sigue con la proxima;\nel error de base va al log
  end
end

GI --> NG : contadores de la corrida
deactivate GI
NG --> E : 201 + resumen

@enduml
