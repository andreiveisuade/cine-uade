' Diagrama de clases del dominio de cine-uade. Fuente de dominio/build.mjs, que dibuja clases-dominio.svg.
' Cada relación se lee como oración del origen al destino: Reserva "0..*" --> "1" Funcion : es para >
' Las referencias por id con FK en el schema (Pago.reservaId) se dibujan como asociación.

@startuml clases-modelo
!pragma layout elk
title CINE UADE — diagrama de clases del dominio
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
set separator none
hide empty members

package "model.cartelera" {
  class Pelicula <<Entity>> {
    - id : int
    - titulo : String
    - duracionMinutos : int
    - clasificacion : Clasificacion
    - generos : List<Genero>
    - catalogo : CatalogoPelicula
    - enCartelera : boolean
    - trailerYoutube : String
    - estadoRevision : EstadoRevision
    + Pelicula(titulo : String, duracionMinutos : Integer, generos : List<Genero>, clasificacion : Clasificacion)
    + actualizar(titulo : String, duracionMinutos : Integer, generos : List<Genero>, clasificacion : Clasificacion) : void
    + cambiarCatalogo(catalogo : CatalogoPelicula) : void
    + cambiarTrailer(texto : String) : void
    + completarTrailer(trailer : TrailerYoutube) : void
    + estaEnCartelera() : boolean
    + ponerEnCartelera() : void
    + exigirProgramable() : void
    + seMuestraAlPublico() : boolean
    + sacarDeCartelera() : void
    + dejarPendiente() : void
    + confirmar() : void
    + descartar() : void
  }
  class CatalogoPelicula <<Embeddable / ValueObject>> {
    - director : String
    - sinopsis : String
    - anio : int
    - idiomaOriginal : String
    - posterUrl : String
    - puntaje : double
    - votos : int
    + conCambios(director : String, sinopsis : String, anio : Integer, idiomaOriginal : String, posterUrl : String, puntaje : Double, votos : Integer, hoy : LocalDate) : CatalogoPelicula
  }
  class TrailerYoutube <<ValueObject / Record>> {
    - id : String
    + TrailerYoutube(id : String)
    + {static} siEs(texto : String) : Optional<TrailerYoutube>
  }
  enum Clasificacion {
    ATP
    MAS_13
    MAS_16
    MAS_18
    - edadMinima : int
    + getEtiqueta() : String
  }
  enum Genero {
    ACCION
    COMEDIA
    DRAMA
    TERROR
    CIENCIA_FICCION
    ANIMACION
    DOCUMENTAL
    ROMANCE
    SUSPENSO
  }
  enum EstadoRevision {
    PENDIENTE
    CONFIRMADA
    DESCARTADA
    ~ {abstract} exigirPublicable(titulo : String) : void
    ~ {abstract} exigirProgramable(titulo : String) : void
    ~ {abstract} seMuestraAlPublico() : boolean
  }
  class Importacion <<Entity>> {
    - id : int
    - paginas : int
    - pedidaEn : LocalDateTime
    - estado : EstadoImportacion
    - terminoEn : LocalDateTime
    - resumen : ResumenDeCorrida
    + Importacion(paginas : Integer, pedidaEn : LocalDateTime)
    + terminar(resumen : ResumenDeCorrida, cuando : LocalDateTime) : void
    + fallar(motivo : String, cuando : LocalDateTime) : void
    + estaEnCurso() : boolean
    + quedoColgada(plazo : Duration, ahora : LocalDateTime) : boolean
    + terminoHaceMenosDe(espera : Duration, ahora : LocalDateTime) : boolean
  }
  enum EstadoImportacion {
    EN_CURSO
    TERMINADA
    FALLIDA
    ~ terminar() : EstadoImportacion
    ~ fallar() : EstadoImportacion
    + estaEnCurso() : boolean
  }
  class ResumenDeCorrida <<Embeddable / Record>> {
    - nuevas : int
    - salteadas : int
    - fallidas : int
    - detalle : String
    + {static} deFalla(motivo : String) : ResumenDeCorrida
  }
  class RenglonDeCorrida <<Record>> {
    - resultado : Resultado
    - peliculaId : Integer
    - titulo : String
    - motivo : String
    + {static} nueva(peliculaId : int, titulo : String) : RenglonDeCorrida
    + {static} yaEstaba(titulo : String) : RenglonDeCorrida
    + {static} rechazada(titulo : String, motivo : String) : RenglonDeCorrida
    + texto() : String
    + {static} leer(detalle : String) : List<RenglonDeCorrida>
  }
}

