@startuml clases-dominio
title Modelo de dominio - Sistema de cine

skinparam classAttributeIconSize 0
hide empty members

interface Pelicula {
  +getTitulo(): String
  +getDuracionMinutos(): int
  +getGeneros(): List<Genero>
}

interface Sala {
  +getNombre(): String
  +getTipo(): TipoSala
  +getButacasPorFila(): List<Integer>
  +getFilas(): int
  +getCapacidadSala(): int
}

interface Asiento {
  +getSalaId(): int
  +getFila(): int
  +getNumero(): int
  +getTipo(): TipoAsiento
  +getEstado(): EstadoAsiento
  +getCodigo(): String
}

interface Funcion {
  +getPeliculaId(): int
  +getSalaId(): int
  +getInicio(): LocalDateTime
  +getIdioma(): Idioma
  +getProyeccion(): Proyeccion
  +getPrecio(): double
}

interface Cliente {
  +getNombre(): String
  +getEmail(): String
}

interface Reserva {
  +getFuncionId(): int
  +getClienteId(): int
  +getEntradas(): List<Entrada>
  +getCantidadEntradas(): int
  +getEstado(): EstadoReserva
}

interface Entrada {
  +getAsientoId(): int
  +getCodigoAsiento(): String
  +getPrecio(): double
}

enum Genero {
  ACCION
  COMEDIA
  DRAMA
  TERROR
  CIENCIA_FICCION
  ANIMACION
  DOCUMENTAL
  ROMANCE
  SUSPENSO
}

enum TipoSala {
  DOS_D
  TRES_D
  IMAX
  CUATRO_D
  VIP
}

enum TipoAsiento {
  ESTANDAR
  VIP
  PAREJA
  ACCESIBLE
}

enum EstadoAsiento {
  DISPONIBLE
  FUERA_DE_SERVICIO
}

enum Idioma {
  DOBLADA
  SUBTITULADA
}

enum Proyeccion {
  DOS_D
  TRES_D
}

enum EstadoReserva {
  RESERVADA
  PAGADA
  CANCELADA
}

Pelicula "1" *-- "1..*" Genero
Sala "1" -- "1" TipoSala
Asiento "1" -- "1" TipoAsiento
Asiento "1" -- "1" EstadoAsiento
Reserva "1" -- "1" EstadoReserva
Funcion "1" -- "1" Idioma
Funcion "1" -- "1" Proyeccion

Sala "1" *-- "1..*" Asiento
Reserva "1" *-- "1..*" Entrada
Entrada "1" --> "1" Asiento

Funcion "*" --> "1" Pelicula
Funcion "*" --> "1" Sala
Reserva "*" --> "1" Funcion
Reserva "*" --> "1" Cliente

note bottom of Asiento
  El asiento no tiene estado "ocupado":
  lo esta para una funcion, si alguna
  reserva no cancelada de esa funcion
  tiene una Entrada con ese asiento.
end note

note bottom of Funcion
  Las asociaciones se guardan como id
  (peliculaId, salaId): el DAO resuelve
  la relacion.
  Proyeccion es de la funcion, no de la
  sala: TipoSala dice que PUEDE proyectar,
  la funcion que se ESTA proyectando.
end note

package "Pendiente de implementar" <<Cloud>> {
  interface Pago {
    +getReservaId(): int
    +getMedio(): MedioPago
    +getMonto(): double
    +getFecha(): LocalDateTime
  }

  enum MedioPago {
    EFECTIVO
    DEBITO
    CREDITO
    QR
  }

  enum Clasificacion {
    ATP
    MAS_13
    MAS_16
    MAS_18
  }
}

Pago "1" --> "1" Reserva
Pago "1" -- "1" MedioPago
Clasificacion "1" -- "*" Pelicula

note bottom of Pago
  Modelado, sin implementar todavia.
  Hoy PAGADA es solo un estado: no queda
  registro de cuanto ni como se cobro.
end note

note bottom of Clasificacion
  Modelada, sin implementar. Al reservar
  habria que preguntar "Es mayor de X?",
  lo que ademas pide fecha de nacimiento
  en Cliente.
end note

@enduml
