@startuml clases-dominio
title Modelo de dominio - Sistema de cine

skinparam classAttributeIconSize 0
hide empty members

interface Pelicula {
  +getTitulo(): String
  +getDuracionMinutos(): int
  +getGeneros(): List<Genero>
  +getClasificacion(): Clasificacion
  --datos de catalogo--
  +getDirector(): String
  +getSinopsis(): String
  +getAnio(): int
  +getIdiomaOriginal(): String
  +getPosterUrl(): String
  +estaEnCartelera(): boolean
}

interface Sala {
  +getNombre(): String
  +getTipo(): TipoSala
  +getButacasPorFila(): List<Integer>
  +getFilas(): int
  +getCapacidadSala(): int
}

interface Asiento {
  +getSalaId(): int
  +getFila(): int
  +getNumero(): int
  +getTipo(): TipoAsiento
  +getEstado(): EstadoAsiento
  +getCodigo(): String
}

interface Funcion {
  +getPeliculaId(): int
  +getSalaId(): int
  +getInicio(): LocalDateTime
  +getIdioma(): Idioma
  +getProyeccion(): Proyeccion
  +getPrecio(): double
}

interface Usuario {
  +getNombre(): String
  +getEmail(): String
  +getRol(): Rol
}

interface Cliente {
}

interface AdministradorCine {
  +getPasswordHash(): String
}

enum Rol {
  CLIENTE
  ADMINISTRADOR
}

Cliente --|> Usuario
AdministradorCine --|> Usuario
Usuario "1" -- "1" Rol

interface Reserva {
  +getFuncionId(): int
  +getClienteId(): int
  +getEntradas(): List<Entrada>
  +getCantidadEntradas(): int
  +getEstado(): EstadoReserva
}

interface Entrada {
  +getAsientoId(): int
  +getCodigoAsiento(): String
  +getPrecio(): double
}

enum Clasificacion {
  ATP
  MAS_13
  MAS_16
  MAS_18
}

enum Genero {
  ACCION
  COMEDIA
  DRAMA
  TERROR
  CIENCIA_FICCION
  ANIMACION
  DOCUMENTAL
  ROMANCE
  SUSPENSO
}

enum TipoSala {
  DOS_D
  TRES_D
  IMAX
  CUATRO_D
  VIP
}

enum TipoAsiento {
  ESTANDAR
  VIP
  PAREJA
  ACCESIBLE
}

enum EstadoAsiento {
  DISPONIBLE
  FUERA_DE_SERVICIO
}

enum Idioma {
  DOBLADA
  SUBTITULADA
}

enum Proyeccion {
  DOS_D
  TRES_D
}

enum EstadoReserva {
  RESERVADA
  PAGADA
  CANCELADA
}

Pelicula "1" *-- "1..*" Genero
Sala "1" -- "1" TipoSala
Asiento "1" -- "1" TipoAsiento
Asiento "1" -- "1" EstadoAsiento
Reserva "1" -- "1" EstadoReserva
Funcion "1" -- "1" Idioma
Funcion "1" -- "1" Proyeccion

Sala "1" *-- "1..*" Asiento
Reserva "1" *-- "1..*" Entrada
Entrada "1" --> "1" Asiento

Funcion "*" --> "1" Pelicula
Funcion "*" --> "1" Sala
Reserva "*" --> "1" Funcion
Reserva "*" --> "1" Cliente

note bottom of AdministradorCine
  Solo el administrador tiene credenciales:
  el cliente compra sin iniciar sesion.
  Esa diferencia de datos es lo que justifica
  la herencia en vez de un simple enum de rol.
end note

note bottom of Asiento
  El asiento no tiene estado "ocupado":
  lo esta para una funcion, si alguna
  reserva no cancelada de esa funcion
  tiene una Entrada con ese asiento.
end note

note bottom of Funcion
  Las asociaciones se guardan como id
  (peliculaId, salaId): el DAO resuelve
  la relacion.
  Proyeccion es de la funcion, no de la
  sala: TipoSala dice que PUEDE proyectar,
  la funcion que se ESTA proyectando.
end note

interface Pago {
  +getReservaId(): int
  +getMonto(): double
  +getMedio(): MedioPago
  +getFecha(): LocalDateTime
  +getCodigoAutorizacion(): String
}

enum MedioPago {
  EFECTIVO
  DEBITO
  CREDITO
  QR
  TRANSFERENCIA
}

Pago "0..1" --> "1" Reserva
Pago "1" -- "1" MedioPago
Pelicula "*" -- "1" Clasificacion

note bottom of Pago
  El monto no se recibe: sale del total de
  la reserva, asi nadie cobra otro importe.
  Una reserva tiene a lo sumo un pago.
end note

note bottom of Clasificacion
  Guardada en la pelicula. Falta usarla:
  al vender habria que preguntar la edad,
  y validarla de verdad pide fecha de
  nacimiento en Cliente.
end note

@enduml
