@startuml clases-dominio
title Modelo de dominio - Sistema de cine

skinparam classAttributeIconSize 0
hide empty members

interface Pelicula {
  +getTitulo(): String
  +getDuracionMinutos(): int
  +getGeneros(): List<Genero>
}

interface Sala {
  +getNombre(): String
  +getTipo(): TipoSala
  +getButacasPorFila(): List<Integer>
  +getFilas(): int
  +getCapacidadSala(): int
}

interface Asiento {
  +getSalaId(): int
  +getFila(): int
  +getNumero(): int
  +getTipo(): TipoAsiento
  +getEstado(): EstadoAsiento
  +getCodigo(): String
}

interface Funcion {
  +getPeliculaId(): int
  +getSalaId(): int
  +getInicio(): LocalDateTime
  +getPrecio(): double
}

interface Cliente {
  +getNombre(): String
  +getEmail(): String
}

interface Reserva {
  +getFuncionId(): int
  +getClienteId(): int
  +getEntradas(): List<Entrada>
  +getCantidadEntradas(): int
  +getEstado(): EstadoReserva
}

interface Entrada {
  +getAsientoId(): int
  +getCodigoAsiento(): String
}

enum Genero {
  ACCION
  COMEDIA
  DRAMA
  TERROR
  CIENCIA_FICCION
  ANIMACION
  DOCUMENTAL
  ROMANCE
  SUSPENSO
}

enum TipoSala {
  DOS_D
  TRES_D
  IMAX
  CUATRO_D
  VIP
}

enum TipoAsiento {
  ESTANDAR
  VIP
  PAREJA
  ACCESIBLE
}

enum EstadoAsiento {
  DISPONIBLE
  FUERA_DE_SERVICIO
}

enum EstadoReserva {
  RESERVADA
  PAGADA
  CANCELADA
}

Pelicula "1" *-- "1..*" Genero
Sala "1" -- "1" TipoSala
Asiento "1" -- "1" TipoAsiento
Asiento "1" -- "1" EstadoAsiento
Reserva "1" -- "1" EstadoReserva

Sala "1" *-- "1..*" Asiento
Reserva "1" *-- "1..*" Entrada
Entrada "1" --> "1" Asiento

Funcion "*" --> "1" Pelicula
Funcion "*" --> "1" Sala
Reserva "*" --> "1" Funcion
Reserva "*" --> "1" Cliente

note bottom of Asiento
  El asiento no tiene estado "ocupado":
  lo esta para una funcion, si alguna
  reserva no cancelada de esa funcion
  tiene una Entrada con ese asiento.
end note

note bottom of Funcion
  Las asociaciones se guardan como id
  (peliculaId, salaId): el DAO resuelve
  la relacion.
end note

@enduml
