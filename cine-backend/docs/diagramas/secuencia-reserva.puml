@startuml secuencia-reserva
title Reservar butacas: del menu al ticket

skinparam sequenceMessageAlign center
hide footbox

actor Cliente
participant "MenuConsola" as UI
participant "GestorReservas" as Gestor
participant "AsientoDAO" as Asientos <<interface>>
participant "ReservaDAO" as DAO <<interface>>
participant "CalculadoraPrecio" as Precio
participant "GeneradorTicket" as Ticket <<interface>>

Cliente -> UI : elige funcion y cliente
activate UI

UI -> Gestor : asientosLibres(funcionId)
activate Gestor
Gestor -> Asientos : listarPorSala(salaId)
activate Asientos
Asientos --> Gestor : butacas de la sala
deactivate Asientos
Gestor -> DAO : listarPorFuncion(funcionId)
activate DAO
DAO --> Gestor : reservas de esa funcion
deactivate DAO
Gestor -> Gestor : descarta las tomadas y\nlas fuera de servicio
Gestor --> UI : butacas libres
deactivate Gestor

UI --> Cliente : dibuja el mapa de la sala
Cliente -> UI : "A1,A2"

UI -> Gestor : reservar(funcionId, clienteId,\ncodigos)
activate Gestor

alt alguna butaca no existe, esta ocupada\no esta fuera de servicio
  Gestor --> UI : IllegalArgumentException
  UI --> Cliente : motivo del rechazo
else todas disponibles
  loop por cada butaca
    Gestor -> Precio : precioDe(funcion, sala, asiento)
    activate Precio
    Precio --> Gestor : base x tipo de sala\nx tipo de butaca
    deactivate Precio
  end

  Gestor -> DAO : guardar(reserva)
  activate DAO
  DAO --> Gestor : reserva con id asignado
  deactivate DAO

  Gestor -> Ticket : emitir(reserva, funcion,\npelicula, sala, cliente)
  activate Ticket
  Ticket -> Ticket : escribe\ntickets/ticket-N.txt
  deactivate Ticket

  Gestor --> UI : reserva
  UI --> Cliente : "Reserva confirmada.\nTotal: $ X"
end
deactivate Gestor
deactivate UI

note over DAO, Ticket
  El gestor habla con interfaces. Que la reserva termine en MySQL
  o en reservas.txt, y el ticket en un .txt o manana en un PDF,
  no cambia esta secuencia.
end note

@enduml
