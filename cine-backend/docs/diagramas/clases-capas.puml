@startuml clases-capas
title Arquitectura en capas - patron DAO

skinparam classAttributeIconSize 0
skinparam nodesep 12
skinparam ranksep 45
hide members

package ui {
  class MenuConsola
}

package servicio {
  class GestorCartelera
  class GestorSalas
  class GestorFunciones
  class GestorClientes
  class GestorReservas
  class GestorPagos
  class GestorAdministradores
  class CalculadoraPrecio
  class Password
}

package interfaces {
  interface PeliculaDAO
  interface SalaDAO
  interface AsientoDAO
  interface FuncionDAO
  interface ClienteDAO
  interface ReservaDAO
  interface PagoDAO
  interface AdministradorDAO
  interface GeneradorTicket
}

package persistencia {
  class PeliculaDAOMySQL
  class SalaDAOMySQL
  class AsientoDAOMySQL
  class FuncionDAOMySQL
  class ClienteDAOMySQL
  class ReservaDAOMySQL
  class PagoDAOMySQL
  class AdministradorDAOMySQL
  class ReservaDAOTxt
  class GeneradorTicketTxt
  class ConexionMySQL
  class PersistenciaException
}

MenuConsola -down-> GestorCartelera
MenuConsola -down-> GestorSalas
MenuConsola -down-> GestorFunciones
MenuConsola -down-> GestorClientes
MenuConsola -down-> GestorReservas
MenuConsola -down-> GestorPagos
MenuConsola -down-> GestorAdministradores

GestorCartelera -down-> PeliculaDAO
GestorSalas -down-> SalaDAO
GestorSalas -down-> AsientoDAO
GestorFunciones -down-> FuncionDAO
GestorClientes -down-> ClienteDAO
GestorReservas -down-> ReservaDAO
GestorReservas -down-> GeneradorTicket
GestorReservas ..> CalculadoraPrecio
GestorPagos -down-> PagoDAO
GestorPagos -down-> ReservaDAO
GestorAdministradores -down-> AdministradorDAO
GestorAdministradores ..> Password

PeliculaDAOMySQL -up-|> PeliculaDAO
SalaDAOMySQL -up-|> SalaDAO
AsientoDAOMySQL -up-|> AsientoDAO
FuncionDAOMySQL -up-|> FuncionDAO
ClienteDAOMySQL -up-|> ClienteDAO
ReservaDAOMySQL -up-|> ReservaDAO
ReservaDAOTxt -up-|> ReservaDAO
PagoDAOMySQL -up-|> PagoDAO
AdministradorDAOMySQL -up-|> AdministradorDAO
GeneradorTicketTxt -up-|> GeneradorTicket

legend bottom
  |= Capa |= Detalle |
  | ui | Unica capa con Scanner y System.out. Reemplazarla por una API REST no toca ninguna regla. |
  | servicio | GestorReservas usa ademas FuncionDAO, SalaDAO, AsientoDAO, ClienteDAO y PeliculaDAO. |
  |  | GestorFunciones usa tambien PeliculaDAO y SalaDAO, para validar el solapamiento. |
  | persistencia | Cada DAO tiene ademas una implementacion en memoria, para testear sin base de datos. |
  |  | Ninguna clase de esta capa imprime ni valida reglas de negocio. |
endlegend

@enduml
