@startuml clases-capas
title Arquitectura en capas - patron DAO

skinparam classAttributeIconSize 0
hide members

package ui {
  class MenuConsola
}

package servicio {
  class GestorCartelera
  class GestorSalas
  class GestorFunciones
  class GestorClientes
  class GestorReservas
}

package interfaces {
  interface PeliculaDAO
  interface SalaDAO
  interface AsientoDAO
  interface FuncionDAO
  interface ClienteDAO
  interface ReservaDAO
  interface GeneradorTicket
}

package persistencia {
  class PeliculaDAOMySQL
  class PeliculaDAOMemoria
  class SalaDAOMySQL
  class AsientoDAOMySQL
  class FuncionDAOMySQL
  class ClienteDAOMySQL
  class ReservaDAOMySQL
  class ReservaDAOTxt
  class GeneradorTicketTxt
}

MenuConsola -down-> GestorCartelera
MenuConsola -down-> GestorSalas
MenuConsola -down-> GestorFunciones
MenuConsola -down-> GestorClientes
MenuConsola -down-> GestorReservas

GestorCartelera -down-> PeliculaDAO
GestorSalas -down-> SalaDAO
GestorSalas -down-> AsientoDAO
GestorFunciones -down-> FuncionDAO
GestorFunciones -down-> PeliculaDAO
GestorFunciones -down-> SalaDAO
GestorClientes -down-> ClienteDAO
GestorReservas -down-> ReservaDAO
GestorReservas -down-> GeneradorTicket

PeliculaDAOMySQL -up-|> PeliculaDAO
PeliculaDAOMemoria -up-|> PeliculaDAO
SalaDAOMySQL -up-|> SalaDAO
AsientoDAOMySQL -up-|> AsientoDAO
FuncionDAOMySQL -up-|> FuncionDAO
ClienteDAOMySQL -up-|> ClienteDAO
ReservaDAOMySQL -up-|> ReservaDAO
ReservaDAOTxt -up-|> ReservaDAO
GeneradorTicketTxt -up-|> GeneradorTicket

note right of GestorReservas
  Tambien usa FuncionDAO, SalaDAO,
  AsientoDAO, ClienteDAO y PeliculaDAO:
  las butacas libres salen de la sala y
  el ticket lleva datos de todas.
end note

note bottom of persistencia
  Ninguna clase de esta capa imprime ni valida reglas.
  Las de memoria existen para testear sin base de datos.
end note

@enduml
