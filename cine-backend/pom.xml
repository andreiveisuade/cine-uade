<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- El parent de Spring Boot: fija de una vez las versiones de todo el ecosistema
       —Spring, Jackson, Hibernate, el driver JDBC, JUnit— y configura los plugins del
       build. Es la razón por la que abajo casi ninguna dependencia lleva <version>:
       elegirlas a mano es como se llega a una combinación que no existe probada. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <!-- Coordenadas: identifican tu proyecto de forma única -->
  <groupId>ar.uade</groupId>
  <artifactId>cine</artifactId>
  <version>1.0-SNAPSHOT</version>

  <!-- WAR y no jar para poder desplegar en un Tomcat instalado aparte, que es lo que pide
       la cátedra. No se pierde nada a cambio: el plugin de Spring Boot lo repackagea como
       WAR *ejecutable* —las dependencias de scope provided van a WEB-INF/lib-provided— así
       que `java -jar cine-api.war` sigue levantando el Tomcat embebido igual que antes.
       Un solo artefacto sirve para los dos despliegues. -->
  <packaging>war</packaging>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Compila y verifica contra la API de Java 21 -->
    <java.version>21</java.version>
  </properties>

  <dependencies>
    <!-- La API HTTP. Trae Spring MVC, Tomcat embebido y Jackson: es lo que reemplaza a
         Javalin más las tres dependencias que había que declararle a mano. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- El mismo Tomcat que ya venía adentro de starter-web, ahora nombrado explícitamente
         para poder marcarlo `provided`: un Tomcat instalado aparte trae el suyo, y meter un
         segundo servlet container en el WAR es el choque clásico de clases al desplegar.
         `provided` no lo saca de la compilación ni de los tests —ahí sigue disponible— solo
         no lo copia a WEB-INF/lib. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-tomcat</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- Swagger UI y el /v3/api-docs, generados leyendo los @RestController: la doc de la
         API sale del código y no de un archivo aparte que se desactualiza. Lleva <version>
         porque springdoc no lo maneja el parent de Spring Boot. -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>2.8.6</version>
    </dependency>

    <!-- Spring Data JPA: Hibernate como proveedor, el DataSource ya armado a partir de
         application.yml y los repositorios generados desde una interfaz. Es lo que
         reemplaza a los trece DAO de MySQL con sus dos mil líneas de SQL a mano, al
         OrigenMySQL que configuraba el pool con código y a la Plantilla que envolvía
         JDBC. El pool sigue siendo HikariCP: viene adentro de este starter. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!-- Quién llama. Antes cualquiera con curl podía dar de alta una sala: el login solo
         comprobaba la clave y devolvía el empleado, y ninguna otra ruta volvía a
         preguntar. Spring Security pone un filtro delante de todos los controladores, así
         que una ruta nueva nace cerrada y abrirla es una decisión escrita en un solo lugar
         (infrastructure/seguridad/ConfiguracionSeguridad). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!-- Driver JDBC de MySQL. En runtime: nadie lo importa, lo carga el DataSource. -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Cliente de Redis, donde viven los bloqueos de butaca mientras alguien elige. Es
         el cliente canonico, y esta en la misma categoria que el driver de MySQL: hablar
         un protocolo a mano es reinventar algo que ya existe y se rompe en los bordes. -->
    <dependency>
      <groupId>redis.clients</groupId>
      <artifactId>jedis</artifactId>
    </dependency>

    <!-- La base de los tests: en memoria, creada por Hibernate desde las entidades y
         tirada al terminar. Es lo que reemplaza a las catorce implementaciones en
         memoria de los DAO — con la diferencia de que ahora los tests pasan por el
         mapeo y las consultas de verdad, así que un @Query roto se ve en `mvn test` y
         no recién contra MySQL. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Tests. scope=test => no se empaqueta en el jar final. El starter trae JUnit 5,
         AssertJ, Mockito y el soporte de Spring para levantar el contexto en una prueba. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- El jar se sigue llamando cine-api.jar: es lo que copia el Dockerfile. -->
    <finalName>cine-api</finalName>
    <plugins>
      <!-- Arma el jar ejecutable con las dependencias adentro y el main apuntado a la
           clase @SpringBootApplication. Reemplaza al shade: la imagen de Docker corre un
           JRE pelado, sin Maven ni repositorio local del que sacar las dependencias.
           `mvn spring-boot:run` levanta la app sin empaquetar. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
